# Vercel Postgres — auto-populated when you link a Vercel Postgres database.
# For local dev, run `vercel env pull .env.local` or copy these from the
# Vercel dashboard > Storage > your database > .env.local tab.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Anthropic API key — used server-side to parse pasted recipes with Claude.
ANTHROPIC_API_KEY=
