# Prisma Postgres connection strings.
# If using Vercel Postgres: link the database in the Vercel dashboard,
# then run `vercel env pull .env.local` to populate these automatically.
# If using another Postgres host, set the connection strings manually.
DATABASE_PRISMA_DATABASE_URL="postgres://9344bf76e194b01428dd1fda4ed13866a502a663548730e18362256e6b5ba8db:sk_N9reZ-z-pneMGhUvQtnF9@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_PRISMA_DATABASE_URL="postgres://9344bf76e194b01428dd1fda4ed13866a502a663548730e18362256e6b5ba8db:sk_N9reZ-z-pneMGhUvQtnF9@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_POSTGRES_URL="postgres://9344bf76e194b01428dd1fda4ed13866a502a663548730e18362256e6b5ba8db:sk_N9reZ-z-pneMGhUvQtnF9@db.prisma.io:5432/postgres?sslmode=require"

# Anthropic API key — used server-side to parse pasted recipes with Claude.
ANTHROPIC_API_KEY=


# Vercel Blob (recipe photos). New stores use OIDC: connect the store to the project,
# then `vercel env pull` brings in BLOB_STORE_ID and VERCEL_OIDC_TOKEN.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
# Older stores use a static token instead:
# BLOB_READ_WRITE_TOKEN=
