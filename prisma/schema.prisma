generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_PRISMA_DATABASE_URL")
  directUrl = env("DATABASE_POSTGRES_URL")
}

model Recipe {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  prepTime    String   @default("") @map("prep_time")
  cookTime    String   @default("") @map("cook_time")
  servings    String   @default("")
  ingredients Json     @default("[]")
  steps       Json     @default("[]")
  tags        String[] @default([])
  sourceUrl   String?  @map("source_url")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")

  // "This week" queue. Null means not planned.
  queuedAt    DateTime? @map("queued_at")
  plannedDay  String?   @map("planned_day") // mon..sun, or null for "any day"

  cookLogs       CookLog[]
  shoppingChecks ShoppingCheck[]

  @@map("recipes")
}

// One row per time a recipe was cooked to completion.
model CookLog {
  id       Int      @id @default(autoincrement())
  recipeId Int      @map("recipe_id")
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cookedAt DateTime @default(now()) @map("cooked_at")
  note     String   @default("")

  @@index([recipeId, cookedAt])
  @@map("cook_logs")
}

// A checked-off grocery item. Presence of a row means "got it".
model ShoppingCheck {
  recipeId Int    @map("recipe_id")
  idx      Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, idx])
  @@map("shopping_checks")
}
